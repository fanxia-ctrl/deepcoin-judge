# judge 的模型凭证。复制成 config.env 填好即可开跑（config.env 已被 gitignore）。
# 两种任选其一，--llm auto 会挑配好的那个。

# ── 方式一：任何 OpenAI 兼容端点（推荐，能开 JSON mode）──
# JUDGE_BASE_URL=https://your-endpoint/v1
# JUDGE_API_KEY=sk-xxxx
# JUDGE_MODEL=qwen3.6-72b

# ── 方式二：Dify 应用 ──
# JUDGE_DIFY_API_KEY=app-xxxx
# JUDGE_URL=https://ngrok.deeptest.cc/v1/chat-messages
# 应用 Start 有必填变量时给一份 JSON：
# JUDGE_DIFY_INPUTS={"user_id":"judge"}

# 可选
# JUDGE_TIMEOUT=120
# JUDGE_JSON_MODE=1
