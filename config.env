# judge 的模型凭证。仓库私有，随 clone 走，服务器上不用再配。
JUDGE_BASE_URL=http://162.62.213.254:8000/v1
JUDGE_API_KEY=dc-glm53-2026
JUDGE_MODEL=glm-5.3
JUDGE_TIMEOUT=120
# 这个端点支不支持 response_format 待测；不支持就改成 0
JUDGE_JSON_MODE=1
# judge 端点是裸 IP，不走系统代理（macOS 上 urllib 会读系统代理，bench 那套会把它代理成 502）
JUDGE_NO_PROXY=1
# 关掉 glm-5.3 的思考：probe 验过有效（思考 2159 字 → 0），省一半时间
JUDGE_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
