# judge 的请求缓存，机器相关
data/runs/*/cache.jsonl

# 标注原件（含真实用户 query，按需另行同步）
data/labels/*.xlsx

__pycache__/
*.pyc
.DS_Store
.venv/
data/kb_corpus.index

# 判定失败时的模型原始输出（截断、思考烧光预算），排查用，不进库
data/runs/*/failed/

# 增量复核表：cli.py sheet --vs 随时能重导，是发给标注的中间件，不是 run 产物
data/runs/*/增量复核表*.xlsx

# 服务的运行数据：任务库、模型缓存、每个任务的产物
data/service/

# 服务调用方的 API key（serve.sh 首次启动时生成）
service.keys
